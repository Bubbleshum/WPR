<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exploratory probe, deliberately NOT part of WPR.sln.

    It proves out the WP8 "Modern Native" execution path: load an ARMv7 Thumb-2 PE,
    run it under an emulated CPU, and trap every call that leaves the binary. The approach
    graduated: the runtime lives in Src/Engine/WPR.Engine.Wp8Native/Runtime, and this probe
    compiles those same files with its own Program.cs and the Unicorn CPU (GPLv2, so it never
    ships). Nothing in Runtime/ may name an XNA or engine type, or this stops building.

    Native library note: UnicornEngine.Unicorn 2.1.3 ships runtimes for linux-x64,
    linux-arm64, linux-ppc64le and osx-x64 only - there is NO win-x64 unicorn.dll in
    the package. See README.md for how to run it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WPR.Wp8Native</RootNamespace>
    <AssemblyName>WPR.Wp8Probe</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Desktop/ is the WinForms host, a separate project that compiles these same sources. It has
    to be kept out of this project's default glob or the console probe picks up a second
    Program and a dependency on System.Windows.Forms it cannot have under WSL.
  -->
  <ItemGroup>
    <Compile Remove="Desktop\**" />
    <None Remove="Desktop\**" />
    <!-- UnicornConst is the engine's stand-in for the Unicorn package this project references. -->
    <Compile Include="..\..\..\Src\Engine\WPR.Engine.Wp8Native\Runtime\*.cs"
             Exclude="..\..\..\Src\Engine\WPR.Engine.Wp8Native\Runtime\UnicornConst.cs"
             Link="Runtime\%(Filename)%(Extension)" />
    <!-- The runtime's Xbox Live contract lives in its own engine project (shared with the managed facade). -->
    <Compile Include="..\..\..\Src\Engine\WPR.Engine.XboxLive\IXboxLiveHost.cs" Link="Runtime\IXboxLiveHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UnicornEngine.Unicorn" Version="2.1.3" />
  </ItemGroup>

  <!--
    A win-x64 unicorn.dll dropped next to this file is copied to the output and picked up
    automatically: the binding P/Invokes "unicorn", which .NET resolves to unicorn.dll on
    Windows and libunicorn.so on Linux. Nothing else about the probe is platform-specific,
    so that one file is the whole difference between WSL-only and native.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\Src\Engine\WPR.Engine.Wp8Native\Native\wprcpu.dll')">
    <None Include="..\..\..\Src\Engine\WPR.Engine.Wp8Native\Native\wprcpu.dll" Link="wprcpu.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\unicorn.dll')">
    <None Include="unicorn.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
