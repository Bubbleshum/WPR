<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WP8 API census: every import of every ARM PE in every WP8 XAP in the library, checked
    against what the runtime implements, ranked by titles (Plans/RUNTIME-CONVERGENCE.md).

      run Tools/Wp8/Wp8Census (dotnet run, double-dash project option) with arguments: <out-dir> <library-root> [...]

    Not part of WPR.sln.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Src\Engine\WPR.Engine.Wp8Native\WPR.Engine.Wp8Native.csproj" />
  </ItemGroup>

</Project>
