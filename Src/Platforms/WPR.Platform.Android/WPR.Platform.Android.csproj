<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <RootNamespace>WPR.Platform.Android</RootNamespace>
    <!-- Assembly name follows the project name (renamed from WPR.UI.Android on 2026-08-29,
         alongside the Windows head). Stated explicitly rather than left to default because
         it is easy to change by accident and nothing fails loudly if it drifts.
         Nothing game- or user-facing keys off it, which is what made the rename safe:
           * the apk/package identity is the manifest package (com.wpr.android), not this;
           * every real activity pins its Java class name with [Register("com.wpr.android.X")],
             so the ACWs do not move (only the unreferenced SplashActivity uses a
             hash-derived crc64 name, and the manifest is regenerated each build anyway);
           * release.yml globs *-Signed.apk rather than naming the assembly;
           * Properties/Resources is looked up as $(RootNamespace).Properties.Resources.
         Note ApplicationId below (com.MediaExplorer.WPR) still does not match the manifest
         package - pre-existing, the manifest wins. -->
    <AssemblyName>WPR.Platform.Android</AssemblyName>
    <!-- 24 (Android 7.0). The .NET 10 Android workload declares a floor of 21 for every ABI, so
         24 is a product decision rather than a toolchain limit: the lowest version anyone has
         reported against is 10 (issue #40), and nothing below that has ever been tested. Must
         stay <= TargetPlatformVersion or NETSDK1135 fires. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <!--
      CoreCLR instead of MonoVM. This is the whole reason for the net10/API36 move.

      MonoVM's IL importer refuses a shape WP7 obfuscators emit constantly: it does not import
      unreachable instructions, so the evaluation-stack state carried into a branch target comes
      from the nearest *reachable* predecessor — looking straight past the obfuscator's dead code
      — and a `pop` there then underflows. The whole of ApplicationPatcher's
      RelocateMonoStackConflictBlocks exists to rewrite game IL around it, across 5,000+ blocks in
      32 assemblies, and it has shipped three regressions (v27/v28/v29).

      Measured 2026-09-23 with a 20-instruction repro carrying the exact shape, same app, same
      device, same .NET 10.0.11 — only the runtime differing:
          MonoVM  -> InvalidProgramException: Invalid IL code ... IL_001c: pop
          CoreCLR -> accepted, ran
      Upgrading and staying on Mono does NOT fix it: the newest Mono still refuses it.

      The APK ships libcoreclr.so + libclrjit.so and no libmonosgen-2.0.so; the JIT is required
      and non-negotiable, because WPR loads patched game IL at runtime through
      AssemblyLoadContext.LoadFromStream. That is also why PublishAot must never be turned on
      here — NativeAOT has no JIT and cannot execute IL that was not compiled ahead of time.
    -->
    <UseMonoRuntime>false</UseMonoRuntime>
    <!-- Avalonia 11.x has no net10.0-android asset; 12.x is the first that does. Nothing in this
         head initialises Avalonia — the package is referenced only so MyTheme.NoActionBar has the
         AndroidX AppCompat resources to parent onto. -->
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <ApplicationId>com.MediaExplorer.WPR</ApplicationId>
    <!-- Android versionCode. Must strictly increase between releases or a device refuses the
         sideload as a downgrade, so it is bumped per release independently of the version NAME
         (release.yml overrides it with the workflow run number). 1 -> 2 for 0.1.01, 2 -> 3 for 0.1.02. -->
    <ApplicationVersion>3</ApplicationVersion>
    <!-- From $(WprVersion) in Src/Directory.Build.props; release.yml overrides it per release. -->
    <ApplicationDisplayVersion>$(WprVersion)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
    <!--
      TRIMMING IS FORCED ON BY CoreCLR, AND EVERY WPR ASSEMBLY MUST BE ROOTED BELOW.

      This used to be False. Under CoreCLR it cannot be: the CoreCLR runtime pack ships the BCL as
      ReadyToRun images (native code alongside IL), and with PublishTrimmed != true the Android SDK
      runs _LinkAssembliesNoShrink, which Cecil-rewrites every resolved assembly and dies on the
      first R2R one with "XALNS7015: Writing mixed-mode assemblies is not supported". Setting it
      true skips that target entirely and uses ILLink instead.

      TrimMode=partial so only assemblies that opt in (the BCL) are trimmed at all — but that is
      NOT sufficient on its own. WPR's shim assemblies exist solely to be bound by PATCHED GAME IL
      loaded from disk at runtime, which ILLink cannot see, so anything it does prune is exactly
      what a game needs. Every assembly a game can bind is therefore rooted whole.
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- ReadyToRun OFF. The CoreCLR Android build otherwise AOT-compiles every app assembly into
         obj/.../R2R/, producing mixed-mode images (native + IL) that the Android SDK's own
         AssemblyModifierPipeline then cannot Cecil-rewrite — the same XALNS7015 as above, just
         from a later stage. WPR needs a JIT at runtime regardless (game IL arrives from disk), so
         precompiling only the shell buys little, and startup here is dominated by content loading
         rather than JIT. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Keep real exception messages. Trimming defaults UseSystemResourceKeys to true, which
         replaces every BCL message with its resource key — a launch failure then reads
         "ArgumentNull_Generic Arg_ParamName_Name, type" instead of naming the parameter, which
         makes the per-game log and the user-facing error dialog close to useless. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- android-arm (32-bit ARM, RID linux-bionic-arm) dropped: Google Play
         has required 64-bit since 2019, and the 32-bit ARM runtime pack is
         not installed on this machine (NU1101 for
         Microsoft.NETCore.App.Runtime.linux-bionic-arm). -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!--
      DO NOT re-add XamarinGoogleGuavaListenableFutureOptOut / XamarinGoogleGuavaOptOut.
      They were added in 2ce1cd2c and made the launcher die on every launch, in BOTH Debug and
      Release. androidx.profileinstaller registers itself through androidx.startup's
      InitializationProvider, so ProfileInstallerInitializer fires a few seconds after the first
      activity appears; ProfileInstaller.writeProfile needs
      androidx.concurrent.futures.AbstractResolvableFuture, which needs guava's
      ListenableFuture. Opting guava out strips it, the initializer throws
      NoClassDefFoundError on a background thread, and the process goes down with SIGSEGV.
      Removed 2026-08-31.

      Measured on the Pixel_Dev emulator (API 36 x86_64): with the opt-outs present the app
      SIGSEGVs ~9 s after launch and returns to the home screen; with them removed it reaches
      the Start screen and stays up. If they ever need to come back (to resolve a duplicate-class
      conflict, say), the profileinstaller initializer has to be disabled at the same time —
      the two cannot both be present.
    -->
  </PropertyGroup>
  <!--
    Seed databases + per-game achievement catalogues, taken straight from the shared
    Core/WPR.Database/Data and linked to Database/... inside the APK, which is the path
    WprStartup.CopyFileFromAssets reads on first run.

    This replaced a CopyPremadeDb target that copied $(SolutionDir)Database\**\*.* into
    $(ProjectDir)\Database\ and then globbed the copies. That worked, but the copies landed
    inside the project and 1115 of them were committed, duplicating the whole data set in git.
    Linking the originals removes the intermediate copy entirely, so the duplication cannot
    come back — and it drops the ordering hazard where the static AndroidAsset items below were
    evaluated at project load, before the copy target had run.
  -->
  <ItemGroup>
    <AndroidAsset Include="$(SolutionDir)Core\WPR.Database\Data\**\*.*" Link="Database\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The Engine tier: this head declares its platform through PlatformDescriptor and the
         composition root fills every registry (Stage 6). -->
    <ProjectReference Include="$(SolutionDir)Engine/WPR.Engine/WPR.Engine.csproj" />
    <!-- Notifications/: this head implements INotificationManager over Android channels. -->
    <ProjectReference Include="$(SolutionDir)Engine/WPR.Engine.Notifications/WPR.Engine.Notifications.csproj" />
    <!-- Notification module: INotificationManager over Android notification channels. -->
    <ProjectReference Include="$(SolutionDir)Modules/Notifications/WPR.Notifications.AndroidChannel/WPR.Notifications.AndroidChannel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sets FNA3D_FORCE_DRIVER=OpenGL in the real process environment (all processes of the app,
         including GameActivity's :game one), which is what SDL_GetHint/SDL_getenv reads. The file
         itself carries the full rationale and the revert instructions — read it before changing
         graphics behaviour on Android. -->
    <AndroidEnvironment Include="fna3d.env" />
  </ItemGroup>

  <!-- The localized launcher strings used to live here as Properties/Resources.resx, byte
       identical to the desktop head's copy and, per the comment that used to sit here, "meant to
       stay in sync" by hand. They moved to WPR.Shell on 2026-09-02, where both heads share one
       copy. Reach them as WPR.Shell.Resources. -->



  <PropertyGroup Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='RelWithDebInfo'">
    <PublishTrimmed>False</PublishTrimmed>
    <RunAOTCompilation>False</RunAOTCompilation>
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- Embed assemblies so adb-installed APKs run without VS fast-deploy (.__override__). -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
    <AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
  </PropertyGroup>

  <ItemGroup>
    <!-- The launcher shell is native (no Avalonia application is ever started here), but
         this package still supplies the AndroidX AppCompat resources that
         @style/MyTheme.NoActionBar parents onto for GameActivity and the splash. -->
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <!-- MessageBoxUtils / ServicesSetup are typed against MessageBox.Avalonia's button and
         icon enums (the shared vocabulary Guide.ShowMessageBoxFunc speaks); the Android
         implementation renders them with AlertDialog. Came in transitively from WPR.UI. -->
    <PackageReference Include="MessageBox.Avalonia" Version="2.2.0" />
    <!-- Backs the staged Notifications/AndroidNotificationManager.cs (NotificationManagerCompat,
         IconCompat). Kept so the file compiles even though the wiring in MainActivity is
         currently commented out. Pinned to match the version Avalonia.Android already pulls in
         transitively (a lower version triggers NU1605 downgrade-as-error), so this tracks the
         Avalonia bump: 11.3.9 wanted 1.12.0.2, 12.1.3 -> AppCompat 1.7.1.3 -> 1.17.0.2. -->
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.17.0.2" />
    <!-- Bumped 2.0.6 -> 2.1.13 alongside the SQLitePCLRaw.bundle_e_sqlite3 pin in WPR.Loader /
         GamerServices (CVE-2025-6965). Keeping the explicit provider ref on the same version as
         the bundle avoids a split graph where the android leg loads a 2.0.x provider against a
         2.1.x core. -->
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.13" />
    <PackageReference Include="System.ServiceModel.Http" Version="4.10.0" />
    <!-- The System.Formats.Asn1 pin retired with the move to net10 (2026-09-25); the Windows head
         carries the full account and the two must stay in step. It lifted the 5.0.0 that
         System.ServiceModel.* -> System.Private.ServiceModel 4.10.0 ->
         System.Security.Cryptography.Pkcs 5.0.0 still drags in, off CVE-2024-38095 /
         GHSA-447r-wph3-92pm (High, CVSS 8.7). From net10 the shared framework supplies it, so the
         pin would only name an assembly older than the runtime's own (NU1510). -->
    <!-- CVE-2022-34716 / GHSA-vh55-786g-wjwj (Moderate, CVSS 5.9): System.Security.Cryptography.Xml
         5.0.0-6.0.0 can disclose privileged information (XML signature verification). Reached at
         5.0.0 via System.ServiceModel.* -> System.Private.ServiceModel 4.10.0. Pinned to 8.0.4 — NOT 8.0.0,
         which carries eight High advisories of its own (incl. CVE-2026-33116, patched 8.0.3). Not a High like its
         neighbours above, but it is the last advisory in the repo and the same one-line pin. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="4.10.0" />
    <!--PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.5.0" /-->
    <!--PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.5.1" /-->
    <PackageReference Include="XamlNameReferenceGenerator" Version="1.3.4" />
    <!-- Backs Input/AndroidAccelerometerProvider — the device accelerometer behind IAccelerometerProvider.
         Moved here 2026-08-30 from WPR.Framework.Devices.Sensors (and a dead copy in
         WPR.Common), where it was resolved for the desktop leg too even though the only code
         using it was inside #if __ANDROID__. This is the sole consumer in the repo, and the one
         API it uses is Accelerometer; the package is EOL, so if it ever needs replacing the swap
         is Android's own SensorManager, entirely inside this file's neighbour. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\JavaBindings\Org.Libsdl.App\Org.Libsdl.App.csproj" />
    <!-- Moved here from WPR.Loader on 2026-08-31, with FFmpegKitAudioTranscoder — this head is the
         only thing that can call it. ffmpeg-kit links ffmpeg as a LIBRARY and exposes its CLI over
         JNI, which is what makes it the Android half of the IAudioTranscoder seam: FFMpegCore, on
         the Windows side, spawns an ffmpeg process, and an APK has none to spawn.

         The native libs this needs (libffmpegkit.so, libavcodec.so, libavformat.so, libswresample.so)
         were already in Libraries/<abi>/ and already in the APK. What was missing was the managed
         API: the binding project targeted plain net8.0, so class-parse never ran and it produced an
         assembly with no types in it. Fixed in the same change. -->
    <ProjectReference Include="$(SolutionDir)\JavaBindings\com.arthenica.ffmpegkit\com.arthenica.ffmpegkit.csproj" />
    <!-- assembly-store-reader is deliberately NOT referenced any more. It existed so
         WprStartup could pull FNA.dll back out of the APK's own assembly packaging; under
         .NET 10 that packaging is lib/<abi>/libassembly-store.so and the reader found
         nothing, which silently broke on-device patching. FNA.dll is now shipped as a plain
         asset (see _WprStageFnaAssetForCecil at the end of this file), so nothing needs to
         parse the APK's internals. The project is still in the tree and the solution; delete
         it once it is clear nothing wants it back. -->
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Runtime\WPR.Runtime.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Loader\WPR.Loader.csproj" />
    <!-- FNA game-loop host driver (ApplicationLaunch + FnaGameHost/IGameHost) — Stage 4. -->
    <ProjectReference Include="$(SolutionDir)\Backends\WPR.Backend.FNA\WPR.Backend.FNA.csproj" />
    <!-- Song playback over android.media.MediaPlayer, registered into AudioBackendRegistry by
         ServicesSetup. It lived in this head's Audio/ folder until 2026-09-01; it is a framework
         seam implementation, not head code, so it is now a peer of WPR.Audio.FAudio under
         Src/Audio/ and this is a composition reference only. -->
    <ProjectReference Include="$(SolutionDir)\Modules\Audio\WPR.Audio.AndroidMediaPlayer\WPR.Audio.AndroidMediaPlayer.csproj" />
    <!-- Input/: this head implements WPR.Engine.Sensors.IAccelerometerProvider over the device's
         accelerometer and registers it into WPR.Sensors.SensorBackend (which ships inside the
         sensors framework, beside its consumer). Both were reached transitively via
         WPR.Backend.FNA before; explicit now that the head is a first-class implementer. -->
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Devices.Sensors\WPR.Framework.Devices.Sensors.csproj" />
    <ProjectReference Include="..\..\Core\WPR.Shell\WPR.Shell.csproj" />
    <ProjectReference Include="..\..\Modules\Input\WPR.Input.AndroidSensor\WPR.Input.AndroidSensor.csproj" />
    <!-- The handset vibration motor, declared through caps.Vibration(...). Needs
         android.permission.VIBRATE in AndroidManifest.xml — a normal, install-time permission, so
         there is nothing to request at runtime. -->
    <ProjectReference Include="..\..\Modules\Vibration\WPR.Vibration.AndroidVibrator\WPR.Vibration.AndroidVibrator.csproj" />
    <!-- Links a game opens (WebBrowserTask), declared through caps.UriLauncher(...). No manifest
         change: ACTION_VIEW needs no permission. -->
    <ProjectReference Include="..\..\Modules\Launchers\WPR.Launchers.AndroidIntent\WPR.Launchers.AndroidIntent.csproj" />
  </ItemGroup>

  <!--
    Trimmer roots. Everything a patched game can bind, kept whole.

    Game IL is loaded from disk at runtime through AssemblyLoadContext.LoadFromStream, so ILLink
    sees no reference to any of it. Without these, a shim type survives only if some WPR code path
    happens to use it too, and the symptom is not a link error: Assembly.GetType(entryPoint)
    silently returns NULL (a type whose base type cannot be resolved does not throw), and the
    launch dies with ArgumentNullException out of Activator.CreateInstance(null).

    Add a row whenever a new assembly joins ApplicationPatcher's redirect tables.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="FNA" />
    <TrimmerRootAssembly Include="Microsoft.Devices.Sensors" />
    <TrimmerRootAssembly Include="Microsoft.Phone" />
    <TrimmerRootAssembly Include="System.Device" />
    <TrimmerRootAssembly Include="WPR.Framework.Xna" />
    <TrimmerRootAssembly Include="WPR.Framework.Silverlight" />
    <TrimmerRootAssembly Include="WPR.Backend.FNA" />
    <TrimmerRootAssembly Include="WPR.Common" />
    <TrimmerRootAssembly Include="WPR.Runtime" />
    <TrimmerRootAssembly Include="WPR.Loader" />
    <TrimmerRootAssembly Include="WPR.Database" />
    <TrimmerRootAssembly Include="WPR.Shell" />
    <TrimmerRootAssembly Include="WPR.Engine" />
    <TrimmerRootAssembly Include="WPR.Engine.Audio" />
    <TrimmerRootAssembly Include="WPR.Engine.Content" />
    <TrimmerRootAssembly Include="WPR.Engine.GameLoop" />
    <TrimmerRootAssembly Include="WPR.Engine.Graphics" />
    <TrimmerRootAssembly Include="WPR.Engine.Input" />
    <TrimmerRootAssembly Include="WPR.Engine.Notifications" />
    <TrimmerRootAssembly Include="WPR.Engine.Sensors" />
    <TrimmerRootAssembly Include="WPR.Engine.Vibration" />
    <TrimmerRootAssembly Include="WPR.Engine.Launchers" />
    <TrimmerRootAssembly Include="WPR.Audio.FAudio" />
    <TrimmerRootAssembly Include="WPR.Audio.AndroidMediaPlayer" />
    <TrimmerRootAssembly Include="WPR.Input.AndroidSensor" />
    <TrimmerRootAssembly Include="WPR.Notifications.AndroidChannel" />
    <TrimmerRootAssembly Include="WPR.Vibration.AndroidVibrator" />
    <TrimmerRootAssembly Include="WPR.Launchers.AndroidIntent" />
  </ItemGroup>


  <!--
    Stage FNA.dll into the APK as a plain asset, for ApplicationPatcher.

    Cecil reads the assembly being patched from a stream, but its BaseAssemblyResolver only
    finds REAL FILES in its search directories — and inside an APK the runtime's own
    assemblies are not files. WprStartup.SetupDllPatchForCecil copies this asset out to
    PatchAssemblies/ and makes that folder the process CWD, which is what puts it on Cecil's
    search path.

    It is shipped as an asset rather than read back out of the APK's own assembly packaging,
    because that packaging is not a stable contract. .NET 8 kept assemblies as plain
    "assemblies/<name>.dll" zip entries; .NET 10 packs them into
    lib/<abi>/libassembly-store.so and force-enables that whenever EmbedAssembliesIntoApk is
    true, so it cannot be turned off. The old reader found nothing, logged
    "Fail to copy DLL $FNA to patch assembly folder (entry not found)", and every install or
    repatch ON THE DEVICE silently produced an unpatched or mis-patched assembly. An asset is
    just a file we put there, so no future change to assembly packaging can break it.

    Sourced from @(ReferencePath) rather than a hardcoded bin path so it follows the
    configuration and TFM, and the build fails loudly if FNA ever stops being referenced.
  -->
  <Target Name="_WprStageFnaAssetForCecil"
          BeforeTargets="_ComputeAndroidAssetsPaths"
          DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_WprFnaReference Include="@(ReferencePath)" Condition=" '%(Filename)' == 'FNA' " />
      <AndroidAsset Include="@(_WprFnaReference)" Link="PatchAssemblies\FNA.dll" />
    </ItemGroup>
    <Error Condition=" '@(_WprFnaReference)' == '' "
           Text="FNA.dll was not found in @(ReferencePath), so it cannot be staged for Cecil. On-device patching would silently produce broken assemblies; see WprStartup.SetupDllPatchForCecil." />
  </Target>

</Project>
