<?xml version="1.0" encoding="utf-8" ?>
<resources>

  <style name="MyTheme">
  </style>

  <style name="MyTheme.NoActionBar" parent="@style/Theme.AppCompat.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowBackground">#121212</item>
  </style>

  <style name="MyTheme.Splash" parent ="MyTheme.NoActionBar">
    <item name="android:windowBackground">@drawable/splash_screen</item>
    <item name="android:windowContentOverlay">@null</item>
  </style>

  <!-- Theme for the native launcher shell (Start / games / achievements / settings /
       about). Parented on the framework Material theme rather than AppCompat: these
       activities are plain android.app.Activity, so nothing here needs AppCompat's
       delegate, and the framework parent keeps the shell independent of whether
       Avalonia keeps pulling AndroidX in. Status and navigation bars are painted the
       same black as the page so the Start screen reads as one edge-to-edge surface,
       the way the phone Start screen did. -->
  <style name="WprTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/wp_background</item>
    <item name="android:colorBackground">@color/wp_background</item>
    <item name="android:statusBarColor">@color/wp_background</item>
    <item name="android:navigationBarColor">@color/wp_background</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:textColorPrimary">@color/wp_foreground</item>
    <item name="android:textColorSecondary">@color/wp_subtle</item>
    <item name="android:alertDialogTheme">@style/WprDialog</item>

    <!-- The system splash screen, made invisible so the intro clip is the first thing seen.
         From Android 12 EVERY app gets one whether it asks or not: the launcher icon inside a
         rounded container over the theme background, drawn before the activity has rendered a
         frame. It cannot be switched off — but it can be told to draw black with no icon, which
         leaves it indistinguishable from the black the clip starts on.

         These attributes are API 31+. Older devices simply do not understand them and ignore
         them, which is why this lives here rather than in a values-v31 copy of the whole theme;
         compileSdk resolves the names either way. -->
    <item name="android:windowSplashScreenBackground">#FF000000</item>
    <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
  </style>

  <style name="WprDialog" parent="@android:style/Theme.Material.Dialog.Alert">
    <item name="android:colorAccent">@color/wp_accent</item>
    <item name="android:textColorPrimary">@color/wp_foreground</item>
    <item name="android:windowBackground">@drawable/wp_dialog_background</item>
  </style>

  <!-- "WPR" — the small, letter-spaced application title that sits above every page
       title. WP7 rendered this in Segoe WP at 20px; sans-serif is the closest stock
       Android face for the regular weight. -->
  <style name="WpAppTitle">
    <item name="android:textSize">13sp</item>
    <item name="android:textColor">@color/wp_subtle</item>
    <item name="android:letterSpacing">0.14</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:singleLine">true</item>
  </style>

  <!-- The large lowercase page title. Segoe WP Light at 72px on the phone;
       sans-serif-light is Roboto Light, the nearest stock equivalent. -->
  <style name="WpPageTitle">
    <item name="android:textSize">40sp</item>
    <item name="android:textColor">@color/wp_foreground</item>
    <item name="android:fontFamily">sans-serif-light</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:singleLine">true</item>
  </style>

  <style name="WpListPrimary">
    <item name="android:textSize">22sp</item>
    <item name="android:textColor">@color/wp_foreground</item>
    <item name="android:fontFamily">sans-serif-light</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:singleLine">true</item>
    <item name="android:ellipsize">end</item>
  </style>

  <style name="WpListSecondary">
    <item name="android:textSize">13sp</item>
    <item name="android:textColor">@color/wp_subtle</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:singleLine">true</item>
    <item name="android:ellipsize">end</item>
  </style>

  <style name="WpBody">
    <item name="android:textSize">15sp</item>
    <item name="android:textColor">@color/wp_foreground</item>
    <item name="android:fontFamily">sans-serif</item>
  </style>

  <style name="WpSectionHeader">
    <item name="android:textSize">13sp</item>
    <item name="android:textColor">@color/wp_subtle</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:letterSpacing">0.06</item>
  </style>

</resources>
