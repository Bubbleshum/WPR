<?xml version="1.0" encoding="utf-8"?>
<!-- One achievement. Locked entries keep the padlock glyph and the dimmed brush the
     Xbox hub used, so a half-finished list still scans at a glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/wp_page_margin"
    android:paddingEnd="@dimen/wp_page_margin"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

  <ImageView
      android:id="@+id/achievementIcon"
      android:layout_width="52dp"
      android:layout_height="52dp"
      android:scaleType="centerCrop"
      android:src="@drawable/ic_wp_lock"
      android:contentDescription="@null" />

  <LinearLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_marginStart="14dp">

    <TextView
        android:id="@+id/achievementName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:textColor="@color/wp_foreground"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/achievementDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/wp_subtle"
        android:textSize="13sp"
        android:maxLines="3"
        android:ellipsize="end" />
  </LinearLayout>

  <TextView
      android:id="@+id/achievementScore"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:fontFamily="sans-serif-light"
      android:includeFontPadding="false"
      android:textColor="@color/wp_foreground"
      android:textSize="20sp" />
</LinearLayout>
