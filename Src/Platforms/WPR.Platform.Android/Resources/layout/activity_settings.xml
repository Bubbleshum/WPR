<?xml version="1.0" encoding="utf-8"?>
<!-- Settings. Deliberately a subset of the desktop page: the storage-path and
     game-library-folder pickers are omitted because Android has no scanned library
     (games arrive one .xap at a time through the document picker) and the data path
     is fixed to the app-private external files dir. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wp_background"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/wp_page_margin"
      android:paddingEnd="@dimen/wp_page_margin"
      android:paddingTop="28dp"
      android:paddingBottom="36dp">

    <TextView
        android:id="@+id/appTitle"
        style="@style/WpAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title" />

    <TextView
        android:id="@+id/pageTitle"
        style="@style/WpPageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="26dp"
        android:text="settings" />

    <TextView
        style="@style/WpSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GAMERTAG" />

    <EditText
        android:id="@+id/gamerTagInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/wp_chrome"
        android:padding="12dp"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/wp_foreground"
        android:textColorHint="@color/wp_disabled"
        android:textSize="18sp"
        android:fontFamily="sans-serif"
        android:hint="Player" />

    <TextView
        style="@style/WpSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="ACCENT COLOUR" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/wp_subtle"
        android:textSize="13sp"
        android:text="applied to the shell immediately, and to games the next time they launch." />

    <GridLayout
        android:id="@+id/accentGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="5" />

    <!-- Vibration. A row rather than a bare Switch because WP7's ToggleSwitch always showed
         its state as a word underneath the header, and the shell copies that. -->
    <TextView
        style="@style/WpSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="VIBRATION" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

      <Switch
          android:id="@+id/vibrationSwitch"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_alignParentEnd="true"
          android:layout_centerVertical="true" />

      <TextView
          android:id="@+id/vibrationStateText"
          style="@style/WpBody"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_alignParentStart="true"
          android:layout_centerVertical="true"
          android:layout_marginEnd="16dp"
          android:text="on" />

    </RelativeLayout>

    <TextView
        android:id="@+id/vibrationNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/wp_subtle"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:text="applies to every game, and to any connected controller. a game already running keeps its current setting until you next launch it." />

    <!-- Graphics driver. Not a Switch, because neither value is "off" and a switch would have
         to label one of them as the absence of the other. Two buttons built in code, using the
         same white-frame selection marker as the accent grid above. -->
    <TextView
        style="@style/WpSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="GRAPHICS" />

    <LinearLayout
        android:id="@+id/graphicsDriverOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/graphicsDriverNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/wp_subtle"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:text="leave this on vulkan. switch to opengl only if games show a black screen or fail to start on this device — some phones cannot run the vulkan path. takes effect the next time you launch a game." />

    <TextView
        style="@style/WpSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="STORAGE" />

    <TextView
        android:id="@+id/storagePathText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/wp_subtle"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/storageNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/wp_subtle"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:text="games are installed here from the .xap you pick. no folder on this device is ever scanned automatically." />

  </LinearLayout>
</ScrollView>
