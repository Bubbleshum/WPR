<?xml version="1.0" encoding="utf-8"?>
<!-- Generic WP list page: title block, optional sub-header, list, empty message. Used
     by both achievement views (game roll-up and per-game detail) — same chrome, only
     the row template differs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wp_background">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/wp_page_margin"
      android:paddingEnd="@dimen/wp_page_margin"
      android:paddingTop="28dp"
      android:paddingBottom="14dp">

    <TextView
        android:id="@+id/appTitle"
        style="@style/WpAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title" />

    <TextView
        android:id="@+id/pageTitle"
        style="@style/WpPageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="achievements" />

    <TextView
        android:id="@+id/pageSubtitle"
        style="@style/WpSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone" />
  </LinearLayout>

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

    <ListView
        android:id="@+id/pageList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@drawable/wp_list_selector"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone"
        android:paddingStart="@dimen/wp_page_margin"
        android:paddingEnd="@dimen/wp_page_margin"
        android:paddingTop="12dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/wp_subtle"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />
  </FrameLayout>
</LinearLayout>
