<?xml version="1.0" encoding="utf-8"?>
<!-- The "games" page. WP page chrome is three fixed bands: the title block, the
     scrolling content, and the app bar pinned to the bottom edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wp_background">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/wp_page_margin"
      android:paddingEnd="@dimen/wp_page_margin"
      android:paddingTop="28dp"
      android:paddingBottom="14dp">

    <TextView
        android:id="@+id/appTitle"
        style="@style/WpAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WINDOWS PHONE RUNTIME" />

    <TextView
        android:id="@+id/pageTitle"
        style="@style/WpPageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="games" />
  </LinearLayout>

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

    <ListView
        android:id="@+id/gameList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@drawable/wp_list_selector"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="@dimen/wp_page_margin"
        android:paddingEnd="@dimen/wp_page_margin"
        android:paddingTop="12dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-light"
          android:textColor="@color/wp_foreground"
          android:textSize="26sp"
          android:text="no games yet" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:fontFamily="sans-serif"
          android:textColor="@color/wp_subtle"
          android:textSize="15sp"
          android:lineSpacingExtra="4dp"
          android:text="tap add below and pick a .xap from your device. nothing is scanned automatically — you choose exactly what gets installed." />
    </LinearLayout>
  </FrameLayout>

  <include layout="@layout/view_appbar" />
</LinearLayout>
