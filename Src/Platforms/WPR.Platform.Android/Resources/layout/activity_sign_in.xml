<?xml version="1.0" encoding="utf-8"?>
<!-- WPR Hub sign-in. Driven by Native/SignInActivity; the three states are shown one at a time. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wp_background"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/wp_page_margin"
      android:paddingEnd="@dimen/wp_page_margin"
      android:paddingTop="28dp"
      android:paddingBottom="36dp">

    <ImageView
        android:id="@+id/hubLogo"
        android:layout_width="wrap_content"
        android:layout_height="88dp"
        android:adjustViewBounds="true"
        android:layout_marginStart="-8dp"
        android:visibility="gone"
        android:contentDescription="WPR Hub" />

    <TextView
        android:id="@+id/appTitle"
        style="@style/WpAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WPR HUB" />

    <TextView
        android:id="@+id/pageTitle"
        style="@style/WpPageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:text="sign in" />

    <TextView
        android:id="@+id/introText"
        style="@style/WpBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="see your friends and what they're playing, put your scores on the leaderboards and keep your achievements. you sign in on the WPR Hub website, so WPR never sees a password." />

    <!-- Pick how to sign in. Signing up is the same step: the first sign-in creates the account.
         The buttons come from the hub's device-code response (SignInActivity.ShowProviders). -->
    <LinearLayout
        android:id="@+id/chooserPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <TextView
          style="@style/WpSectionHeader"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="SIGN IN OR SIGN UP" />

      <LinearLayout
          android:id="@+id/providerButtons"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:orientation="vertical" />

      <TextView
          android:id="@+id/chooserStatusText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:fontFamily="sans-serif"
          android:textColor="@color/wp_subtle"
          android:textSize="13sp"
          android:text="getting ready…" />

      <TextView
          style="@style/WpBody"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:text="new to WPR Hub? pick any of these. the first time you sign in, it makes your WPR Hub account: you choose your gamertag on the page that opens, and a gamerpic afterwards." />

      <TextView
          android:id="@+id/otherDeviceButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="18dp"
          android:paddingTop="8dp"
          android:paddingBottom="8dp"
          android:clickable="true"
          android:focusable="true"
          android:fontFamily="sans-serif"
          android:textColor="@color/wp_subtle"
          android:textSize="15sp"
          android:text="sign in on another device instead ›" />
    </LinearLayout>

    <!-- Waiting for approval. -->
    <LinearLayout
        android:id="@+id/stepsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical">

      <TextView
          style="@style/WpSectionHeader"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="YOUR LINK KEY" />

      <TextView
          android:id="@+id/keyText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:fontFamily="monospace"
          android:textStyle="bold"
          android:textSize="46sp"
          android:letterSpacing="0.08"
          android:textIsSelectable="true"
          android:text="····-····" />

      <TextView
          style="@style/WpBody"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:id="@+id/stepsText"
          android:text="1. open the link page\n2. check it shows this key. if it does not, close it: only approve a key you started yourself.\n3. sign in and approve. this page finishes by itself." />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:orientation="horizontal">

        <TextView
            android:id="@+id/openButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:textColor="@color/wp_foreground"
            android:textSize="16sp"
            android:text="open the page" />

        <TextView
            android:id="@+id/copyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@color/wp_chrome"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:textColor="@color/wp_foreground"
            android:textSize="16sp"
            android:text="copy key" />
      </LinearLayout>

      <TextView
          android:id="@+id/linkPageText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:fontFamily="sans-serif"
          android:textColor="@color/wp_subtle"
          android:textSize="13sp" />

      <ProgressBar
          android:id="@+id/waitingBar"
          style="@android:style/Widget.Material.ProgressBar.Horizontal"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="26dp"
          android:indeterminate="true" />

      <TextView
          android:id="@+id/statusText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:fontFamily="sans-serif"
          android:textColor="@color/wp_subtle"
          android:textSize="13sp"
          android:text="asking WPR Hub for a key…" />
    </LinearLayout>

    <!-- Signed in. -->
    <LinearLayout
        android:id="@+id/donePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

      <ImageView
          android:id="@+id/gamerpicImage"
          android:layout_width="96dp"
          android:layout_height="96dp"
          android:background="@color/wp_chrome"
          android:scaleType="centerCrop"
          android:contentDescription="gamerpic" />

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="16dp"
          android:layout_gravity="center_vertical"
          android:orientation="vertical">

        <TextView
            android:id="@+id/usernameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/wp_foreground"
            android:textSize="30sp" />

        <TextView
            style="@style/WpBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="your scores now go to the leaderboards, including any you played while signed out." />
      </LinearLayout>
    </LinearLayout>

    <!-- Declined, expired, unreachable. -->
    <TextView
        android:id="@+id/failedText"
        style="@style/WpBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

      <TextView
          android:id="@+id/primaryButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="18dp"
          android:paddingEnd="18dp"
          android:paddingTop="12dp"
          android:paddingBottom="12dp"
          android:clickable="true"
          android:focusable="true"
          android:fontFamily="sans-serif"
          android:textColor="@color/wp_foreground"
          android:textSize="16sp"
          android:visibility="gone" />

      <TextView
          android:id="@+id/closeButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:background="@color/wp_chrome"
          android:paddingStart="18dp"
          android:paddingEnd="18dp"
          android:paddingTop="12dp"
          android:paddingBottom="12dp"
          android:clickable="true"
          android:focusable="true"
          android:fontFamily="sans-serif"
          android:textColor="@color/wp_foreground"
          android:textSize="16sp"
          android:text="cancel" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
