<?xml version="1.0" encoding="utf-8"?>
<!-- One label/value pair on the game info page. The value wraps rather than
     ellipsising: most of what this page is for (product IDs, absolute paths) is
     unreadable truncated, and the list is short enough to afford the height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/wp_page_margin"
    android:paddingEnd="@dimen/wp_page_margin"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

  <TextView
      android:id="@+id/infoLabel"
      style="@style/WpListSecondary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />

  <TextView
      android:id="@+id/infoValue"
      style="@style/WpBody"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp" />
</LinearLayout>
