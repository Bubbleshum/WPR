<?xml version="1.0" encoding="utf-8"?>
<!--
     No android:versionName here on purpose. It used to say 0.0.18 and SILENTLY WON over
     -p:ApplicationDisplayVersion, so every release APK shipped 0.0.18 no matter what version the
     release workflow was given (verified: passing 0.0.99 produced versionCode=99 but
     versionName=0.0.18). versionName now comes from $(ApplicationDisplayVersion), i.e.
     $(WprVersion) in Src/Directory.Build.props, overridden per release by release.yml.
     versionCode likewise comes from $(ApplicationVersion). Do not re-add either attribute.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.wpr.android">
 <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
      <uses-permission android:name="android.permission.INTERNET"/>
      <!--
           Achievement unlocks post a notification (SignedInGamer.BeginAwardAchievement ->
           NativeUI.NotificationManager). From API 33 this is a runtime permission and
           NotificationManagerCompat.Notify is a silent no-op without it, so MainActivity
           asks for it on first launch. Declared unconditionally: on API 32 and below it is
           install-time and granted automatically.
      -->
      <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
      <!--
           Microsoft.Devices.VibrateController -> WPR.Vibration.AndroidVibrator. Unlike
           POST_NOTIFICATIONS this is a NORMAL permission at every API level, so it is granted at
           install and there is nothing for MainActivity to request. Without it every
           Vibrator.vibrate throws SecurityException, which the provider logs as [wpr-vibrate] and
           swallows - so the symptom would be games that silently never buzz, not a crash.

           Deliberately not <uses-feature android:name="android.hardware.VIBRATE">: vibration is
           optional here (Vibrator.HasVibrator gates it at runtime) and declaring the feature would
           let Play filter WPR off tablets that lack a motor.
      -->
      <uses-permission android:name="android.permission.VIBRATE"/>
      <!--
           "pin to start" (GameShortcuts -> ShortcutManagerCompat). From API 26 pinning is a
           first-class framework call and needs no permission at all; below that the compat
           library falls back to broadcasting com.android.launcher.action.INSTALL_SHORTCUT, and
           ShortcutManagerCompat.isRequestPinShortcutSupported returns FALSE unless this is
           granted - so without it the action simply never appears on API 21-25.

           A normal, install-time permission, so there is nothing for MainActivity to request.
      -->
      <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT"/>
	<!--
	     @mipmap/ic_launcher, not @drawable/icon: mipmap resources survive the density
	     stripping applied to drawables, and the name resolves to the adaptive icon
	     (mipmap-anydpi-v26) on API 26+ and to the per-density bitmaps below that.
	     @drawable/icon is still the splash centre image (Resources/drawable/splash_screen.xml).
	-->
	<!--
	     enableOnBackInvokedCallback="false" is REQUIRED, and only became required when this head
	     moved to targetSdk 36 (the .NET 10 migration, 2026-09-23). From Android 16 an app that
	     targets 36 gets the predictive-back system animation ON BY DEFAULT, and the price of that
	     is that the legacy back dispatch stops: Activity.OnBackPressed is NEVER CALLED.

	     GameActivity.OnBackPressed is how a Back press becomes one frame of GamePad.Buttons.Back,
	     and it is also what stops the activity finishing itself. With predictive back on, the
	     system finished GameActivity directly instead — so the activity returned its default
	     Result.Canceled, never the Result.Ok that the clean-exit path sets, and GameLauncher
	     reported "the game process exited unexpectedly" over a game that had exited perfectly
	     normally. The symptom is an error dialog on Back, NOT a crash: the :game process was still
	     alive when the launcher declared it dead, and the SIGKILL in the log arrives ~4s later from
	     OnDestroy, which is the normal teardown.

	     It only reproduced on titles that ignore Buttons.Back (Cut the Rope). A game that quits
	     itself on Back — iStunt 2 — wins the race and sets Result.Ok before the system finishes the
	     activity, so it looked fine and hid the bug.

	     Removing this attribute means migrating GameActivity to OnBackInvokedCallback /
	     OnBackPressedDispatcher first. Google will eventually drop the opt-out, so that migration
	     is owed; this keeps the shipped behaviour correct until it happens.
	-->
	<application android:label="WPR" android:icon="@mipmap/ic_launcher" android:enableOnBackInvokedCallback="false">
	</application>
</manifest>
