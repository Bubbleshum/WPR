<!--
  The Windows head's Application. Each platform head owns its own Application so
  it can handle only the lifetime it actually has (classic desktop here, single-view
  on Android) and pick its own base theme. The shared look comes in through the two
  avares:// includes below - see Themes/Brand.axaml.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:WPR.Platform.Windows"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             x:Class="WPR.Platform.Windows.App">
  <Application.DataTemplates>
    <ui:ViewLocator/>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WPR.Platform.Windows/Themes/Brand.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>
    <dialogHost:DialogHostStyles/>
    <StyleInclude Source="avares://WPR.Platform.Windows/Themes/BrandStyles.axaml"/>
  </Application.Styles>
</Application>
