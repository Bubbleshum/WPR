<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-only head: the old WPR.UI.Desktop project carried a plain net8.0 leg for
         Linux/macOS, but nothing shipped on it and the project is now named for the
         platform it targets. A non-Windows desktop head would be its own project. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>WPR.Platform.Windows</RootNamespace>
    <!-- Assembly name follows the project name (renamed from WPR.UI.Desktop on 2026-08-29).
         It is stated explicitly rather than left to default, because it is load-bearing in
         three places that will not fail loudly if it drifts: Avalonia avares:// URIs use the
         ASSEMBLY name as their authority, Packaging/windows/WPR.iss installs and shortcuts the
         exe by filename, and release.yml asserts the published exe exists. WPR.iss carries an
         [InstallDelete] that sweeps the old WPR.UI.Desktop.* payload out of {app} on upgrade,
         so installed copies do not end up with two exes side by side. -->
    <AssemblyName>WPR.Platform.Windows</AssemblyName>
    <!-- Product version comes from $(WprVersion) in Src/Directory.Build.props — set it there, not
         here. release.yml overrides $(Version) from the workflow input at publish time.
         InformationalVersion carries the -alpha suffix and is what the UI displays. -->
    <Version>$(WprVersion)</Version>
    <InformationalVersion>$(WprVersion)-$(WprVersionSuffix)</InformationalVersion>
    <Nullable>enable</Nullable>
    <AvaloniaVersion>11.3.9</AvaloniaVersion>
    <TrimMode>copyused</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <OutputType>WinExe</OutputType>
    <!-- The "Copy pre-made database" target below runs AfterTargets="Build". Rider/VS
         fast up-to-date check skips invoking MSBuild entirely when only content files
         change (e.g. adding a new Database\Achievements\<id>\ catalogue and no .cs edit),
         so the copy target never fires and the new catalogue never reaches the output.
         Disabling FUTDC forces the IDE to invoke a real build every time, guaranteeing
         the copy runs. Costs a few hundred ms per build — acceptable for a dev tool. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <!-- Notification impl (moved from the old DesktopNotifications.Windows project).
       Unconditional now that this head is Windows-only; the null implementation that
       served the old net8.0 leg is gone. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <!-- Avalonia assets. The brand logo is a linked resource sourced from the repo-root
       Images\ folder rather than a copy, so XAML reaches it at
       avares://WPR.Platform.Windows/Assets/logo.png (the avares authority is the ASSEMBLY name,
       not the project name). Assets\avalonia-logo.ico is the Inno Setup installer icon,
       referenced by Packaging\windows\WPR.iss. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\..\Images\logo.png" Link="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="FAudio.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ffmpeg.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="FNA3D.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="FNWP72.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="SDL2.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!--This helps with theme dll-s trimming.
	If you will publish your application in self-contained mode with p:PublishTrimmed=true and it will use Fluent theme Default theme will be trimmed from the output and vice versa.
	https://github.com/AvaloniaUI/Avalonia/issues/5593 -->
    <TrimmableAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmableAssembly Include="Avalonia.Themes.Default" />
  </ItemGroup>
  <ItemGroup>
	<PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <!-- CVE-2026-39959 / GHSA-xrw6-gwf8-vvr9 (High, CVSS 7.1): Tmds.DBus.Protocol < 0.21.3 lets
         malicious D-Bus peers spoof signals, exhaust file descriptors and force unhandled
         exceptions. Avalonia.FreeDesktop 11.3.9 depends on 0.21.2 transitively. Pinned to 0.21.3,
         the in-line fix, rather than 0.92.0 (the other patched version) — 0.21.3 is a patch bump
         Avalonia's dependency range already accepts, whereas 0.92.0 is a different API generation.
         D-Bus is Linux-only, so this ships inert on Windows; pinned anyway because it is in the
         published payload and the fix is free. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="XamlNameReferenceGenerator" Version="1.3.4" />
    <!-- Below came in transitively from the old WPR.UI project; they back code that now
         lives in this head: DialogHost (App.axaml + MainWindowDesktop), MessageBox.Avalonia
         (MessageBoxUtils), EF Core (the achievements / application-listing view-models). -->
    <PackageReference Include="DialogHost.Avalonia" Version="0.10.4" />
    <PackageReference Include="MessageBox.Avalonia" Version="2.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EFVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EFVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Runtime\WPR.Runtime.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Loader\WPR.Loader.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Common\WPR.Common.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Silverlight\WPR.Framework.Silverlight.csproj" />
    <!-- FNA game-loop host driver (ApplicationLaunch + FnaGameHost/IGameHost), used by
         SilverlightLauncher / XnaLauncher. -->
    <ProjectReference Include="$(SolutionDir)\Backends\WPR.Backend.FNA\WPR.Backend.FNA.csproj" />
    <!-- The two backends. Per the ADR the launcher is the composition root: it is the only
         layer that knows which concrete backend to inject, which is what makes them swappable.
         WPR.Backend.Direct3D11 is registered in ServicesSetup.Start(). -->
    <ProjectReference Include="$(SolutionDir)\Backends\WPR.Backend.Direct3D11\WPR.Backend.Direct3D11.csproj" />
    <ProjectReference Include="$(SolutionDir)\ThirdParty\Icons.Avalonia\src\Projektanker.Icons.Avalonia.FontAwesome\Projektanker.Icons.Avalonia.FontAwesome.csproj" />
    <ProjectReference Include="$(SolutionDir)\ThirdParty\Icons.Avalonia\src\Projektanker.Icons.Avalonia\Projektanker.Icons.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Picked up as an EmbeddedResource by the SDK's default **/*.resx glob; the manifest
         name it gets ($(RootNamespace).Properties.Resources) is what Resources.Designer.cs
         hands to ResourceManager. The metadata below only keeps the IDE regenerating the
         designer file when the .resx is edited. -->
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Views\ApplicationItem.axaml.cs">
      <DependentUpon>ApplicationItem.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\EditApplicationDialog.axaml.cs">
      <DependentUpon>EditApplicationDialog.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <Target Name="Copy pre-made database" AfterTargets="Build">
	<ItemGroup>
	  <_CopyItems Include="$(SolutionDir)Core\WPR.Database\Data\**\*.*" />
	</ItemGroup>
	<Copy SourceFiles="@(_CopyItems)" DestinationFolder="$(OutputPath)\Database\%(RecursiveDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
