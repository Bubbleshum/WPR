<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="600"
             x:Class="WPR.Platform.Windows.Pages.MessagesPage">
	<!-- WPR Hub messages: conversations and a new-message box on the left, the open conversation on
	     the right. The lists are built in MessagesPage.axaml.cs; the Android twin is
	     Native/MessagesActivity + Native/ConversationActivity. -->
	<Grid ColumnDefinitions="300,*" Margin="20">
		<DockPanel Grid.Column="0" Margin="0,0,16,0">
			<StackPanel DockPanel.Dock="Top" Spacing="6">
				<TextBlock Text="WPR HUB" FontSize="14" LetterSpacing="2" Foreground="{StaticResource WprAccentBrush}"/>
				<TextBlock Text="Messages" FontSize="30" FontWeight="Light" Foreground="White"/>
				<TextBox Name="toTextBox" Watermark="Player's username" MaxLength="24" Margin="0,10,0,0"/>
				<StackPanel Orientation="Horizontal" Spacing="6">
					<Button Name="messageButton" Classes="play" Content="Message"/>
					<Button Name="requestButton" Content="Send friend request"/>
				</StackPanel>
				<TextBlock Name="leftStatusText" Foreground="#BFFFFFFF" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
			</StackPanel>
			<ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
				<StackPanel Name="conversationsPanel" Spacing="2"/>
			</ScrollViewer>
		</DockPanel>

		<Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="4" Padding="16">
			<DockPanel>
				<StackPanel DockPanel.Dock="Top" Spacing="2">
					<TextBlock Name="withText" Text="No conversation open" FontSize="22" FontWeight="Light" Foreground="White"
					           TextTrimming="CharacterEllipsis"/>
					<TextBlock Name="threadStatusText" Foreground="#BFFFFFFF" FontSize="12" TextWrapping="Wrap"
					           Text="Pick a conversation, or type a friend's username on the left."/>
				</StackPanel>

				<StackPanel DockPanel.Dock="Bottom" Name="composePanel" IsVisible="False" Margin="0,10,0,0">
					<Grid ColumnDefinitions="*,Auto">
						<TextBox Grid.Column="0" Name="bodyTextBox" Watermark="Message (Enter sends, Shift+Enter for a new line)"
						         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000" MaxHeight="120"/>
						<Button Grid.Column="1" Name="sendButton" Classes="play" Content="Send" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
					</Grid>
				</StackPanel>

				<StackPanel DockPanel.Dock="Bottom" Name="notFriendsPanel" IsVisible="False" Spacing="8" Margin="0,10,0,0">
					<TextBlock Foreground="#BFFFFFFF" FontSize="12" TextWrapping="Wrap"
					           Text="You're not friends any more, so this conversation is read-only. You can message each other again once you're friends."/>
					<Button Name="refriendButton" Content="Send friend request" HorizontalAlignment="Left"/>
				</StackPanel>

				<ScrollViewer Name="threadScroll" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
					<StackPanel Name="threadPanel" Spacing="6"/>
				</ScrollViewer>
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
