<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="clr-namespace:WPR.Platform.Windows.Properties"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:Class="WPR.Platform.Windows.Pages.AboutPage">
	<StackPanel Orientation="Vertical" Margin="20">
		<!-- Text set in code-behind from AppVersion so it cannot drift from the window title. -->
		<Label x:Name="VersionLabel" FontSize="30" />
		<Label>(C) Lin Yan::MediaExplorer::Bubbleshum 2022::2026::2026</Label>
		<Label>License: MIT</Label>
	</StackPanel>
</UserControl>
