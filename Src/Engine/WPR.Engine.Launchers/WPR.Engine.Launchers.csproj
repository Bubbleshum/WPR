<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Engine.Launchers - the contract and registry for handing a URI to the host OS.

    "Launchers" is WP7's own word for the Microsoft.Phone.Tasks types that leave the app and open
    something else (WebBrowserTask, EmailComposeTask, BingMapsTask, MarketplaceDetailTask). Those
    shims live in WPR.Framework.Phone, which CONSUMES this, so the contract speaks System.Uri and
    never names a task type - naming one here would invert the reference. Same rule as
    WPR.Engine.Vibration, which this is modelled on.

    Implementations are modules (Src/Modules/Launchers/), declared through caps.UriLauncher(...).
    A platform that declares none leaves every launcher the no-op it always was.

    TFMs mirror WPR.Engine.Vibration. net8.0-windows resolves the plain net8.0 leg.
  -->

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <AssemblyName>WPR.Engine.Launchers</AssemblyName>
    <RootNamespace>WPR.Engine.Launchers</RootNamespace>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

</Project>
