<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Engine.Wp8Native - WP8 "Modern Native" titles (ARMv7 Thumb-2 PE + WinRT/D3D11/XAudio2)
    hosted as an XNA Game, so they run in the same window, graphics stack, input and lifecycle as
    every XNA title: GameActivity/SDL + FNA3D (Vulkan/GL) on Android, D3D11 on Windows.

    The runtime itself - PE loader, trap table, CRT, maths, WinRT and Direct3D stand-ins - is in
    Runtime/ (namespace WPR.Wp8Native). The standalone probe in Tools/Wp8/Wp8Probe compiles the
    same files, so nothing in Runtime/ may name an XNA or engine type. Here WPR_NO_UNICORN is
    defined: Unicorn is GPLv2 and must never ship, so UnicornArmCpu (which lives with the probe) is
    left out and the CPU is always the dynarmic JIT (0BSD), through the wprcpu C shim in Native/:
      * Android: libwprcpu.so in WPR.Platform.Android/Libraries/<abi>/ (built from Native/android)
      * Windows: Native/wprcpu.dll, committed (cross-compiled from WSL); copied to the output when
        present. Without it a native title fails at launch with DllNotFoundException.

    The XNA side lives here: Wp8NativeGame.cs replays the guest's Direct3D 11 frames on the
    framework's GraphicsDevice with the game's own shaders (Wp8GpuReplay.cs; WPR_WP8_GPU=0 falls
    back to the old FrameDrawList, as a diagnostic) and feeds TouchPanel into the guest.
  -->

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net10.0-windows10.0.17763.0;net10.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>WPR.Engine.Wp8Native</AssemblyName>
    <RootNamespace>WPR.Wp8Native</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);WPR_NO_UNICORN</DefineConstants>
    <!-- Runtime/: nullable and analyser noise it was written with (it began as a research probe). -->
    <NoWarn>$(NoWarn);CS8602;CS8600;CS8603;CS8604;CS0414;CA2014;CA1416;CA1422</NoWarn>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Native/ is the C++ shim's source and the prebuilt Windows binary, not part of the build. -->
    <None Remove="Native\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wp8ContractTests: the replay's constant conversion (Wp8GpuReplay.Ordered). -->
    <InternalsVisibleTo Include="Wp8ContractTests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'android' And Exists('Native\wprcpu.dll')">
    <None Include="Native\wprcpu.dll" Link="wprcpu.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)Core\WPR.Framework.Xna\WPR.Framework.Xna.csproj" />
    <ProjectReference Include="$(SolutionDir)Engine\WPR.Engine.Sensors\WPR.Engine.Sensors.csproj" />
    <!-- Launcher.LaunchUriAsync and VibrationDevice reach the platform through these (Wp8HostServices). -->
    <ProjectReference Include="$(SolutionDir)Engine\WPR.Engine.Launchers\WPR.Engine.Launchers.csproj" />
    <ProjectReference Include="$(SolutionDir)Engine\WPR.Engine.Vibration\WPR.Engine.Vibration.csproj" />
    <!-- IXboxLiveHost: shared with the managed Microsoft.Xbox facade (WPR.Framework.Xbox). -->
    <ProjectReference Include="$(SolutionDir)Engine\WPR.Engine.XboxLive\WPR.Engine.XboxLive.csproj" />
  </ItemGroup>

</Project>
