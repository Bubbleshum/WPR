<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Backend.FNA — the FNA rendering/host backend (Stage 4 / 5b, Plans/ARCHITECTURE-MIGRATION.md).

    This is the ONLY layer (with WPR.Backend.Direct3D11) permitted to reference FNA — see the
    fitness function's AllowedReferrers. It is the FNA ADAPTER and nothing more: the RHI seam
    implementations (FnaGraphicsBackend / FnaInputBackend / FnaStorageBackend / FnaPlatformBackend),
    the IGameHost implementation that composes them per launch (FnaGameHost), the SDL-level
    helpers (window icon, driver hint, leaked-window diagnostics, the Vulkan format query), and
    the two Compat types games bind by this assembly's identity.

    The launch sequence itself (ApplicationLaunch) is NOT here any more. It sat in this project
    from Stage 4 (2026-08) until 2026-09-20 because it had been moved in verbatim from
    WPR.Runtime while it still named FNAPlatform and FNA's spine types; once the spine moved into
    WPR.Framework.Xna and the windowing calls went behind IPlatformBackend, what was left naming
    FNA was four lines. It now lives in WPR.Engine.GameLoop beside IGameHost, and reaches the four
    backend-specific steps through WPR.Engine.GameLoop.IGameLaunchHooks, implemented privately by
    FnaGameHost. The keyboard-driven input emulation (tilt components + synthetic touch) moved to
    WPR.Engine.Input at the same time, for the same reason: it derives from framework types, not
    FNA ones.
  -->

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0-windows10.0.17763.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <Nullable>enable</Nullable>
    <!-- FnaGraphicsBackend reinterprets a pinned RhiVertexBufferBinding[] as FNA3D_VertexBufferBinding*
         for FNA3D_ApplyVertexBufferBindings (the only FNA3D graphics entry point with no IntPtr overload). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- IGameHost / GameHostState / TeardownPhase. Was WPR.Abstractions until that project was
         dissolved on 2026-09-01; the contract now sits in its own engine subsystem project. -->
    <ProjectReference Include="$(SolutionDir)Engine\WPR.Engine.GameLoop\WPR.Engine.GameLoop.csproj" />
    <!-- WPR.Models.Application (the row FnaGameHost is constructed with) comes through Loader's
         WPR.Database reference. WPR.Framework.Silverlight / .Phone are no longer referenced: the
         singleton resets that used them moved out with ApplicationLaunch on 2026-09-20. -->
    <ProjectReference Include="$(SolutionDir)Core\WPR.Loader\WPR.Loader.csproj" />
    <ProjectReference Include="$(SolutionDir)Core\WPR.Common\WPR.Common.csproj" />
    <!-- The keyboard-driven input emulation: FnaGameHost wraps its input adapter in the synthetic
         touch decorator through KeyboardEmulation.WrapInput. -->
    <ProjectReference Include="$(SolutionDir)Engine\WPR.Engine.Input\WPR.Engine.Input.csproj" />
    <!-- No WPR.XnaCompability reference. It was here for GraphicsDeviceManager2, which moved into
         this project's Compat/ folder on 2026-08-29 and lost its "2"; nothing here used the shim
         assembly afterwards. Games still bind WPR.XnaCompability at runtime (the patcher rescopes
         their IL to its GraphicsDevice/GraphicsAdapter display-mode overrides), but it reaches the
         launcher output via WPR.Loader, which both platform heads reference. -->
    <ProjectReference Include="$(SolutionDir)Backends\FNA.Platform\FNA.Core.csproj" />
    <!-- The WPR-owned XNA type system (5a/5b). The backend implements its RHI seam
         (WPR.Xna.Rhi.IGraphicsBackend) — see FnaGraphicsBackend. Explicit ref (was
         transitive via FNA) now that the backend is a first-class RHI consumer. -->
    <ProjectReference Include="$(SolutionDir)Core\WPR.Framework.Xna\WPR.Framework.Xna.csproj" />

    <!-- The audio implementation of last resort. FnaGameHost installs FAudioModule as the audio
         registry's BASE so a game always has sound, including on a code path that never runs a
         platform head's ServicesSetup. The FAudio/FACT/Theorafile adapters themselves moved out of
         this project on 2026-09-01 (Src/Audio/WPR.Audio.FAudio) — this is a composition reference,
         not an implementation one, and it is the only thing tying the host to a specific audio
         implementation. A head that wants a different one layers a module over it instead. -->
    <ProjectReference Include="$(SolutionDir)Modules\Audio\WPR.Audio.FAudio\WPR.Audio.FAudio.csproj" />
    <!-- AudioBackendRegistry: FnaGameHost composes the audio seams from the registered modules. -->
    <ProjectReference Include="$(SolutionDir)Engine\WPR.Engine.Audio\WPR.Engine.Audio.csproj" />
    <!-- The platform-declared graphics driver preference, applied in FnaGameHost before
         device creation (Stage 6). -->
    <ProjectReference Include="$(SolutionDir)Engine/WPR.Engine.Graphics/WPR.Engine.Graphics.csproj" />
  </ItemGroup>

</Project>
