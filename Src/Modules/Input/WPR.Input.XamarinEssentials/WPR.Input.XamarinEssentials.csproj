<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Input.XamarinEssentials - the device's real accelerometer, read through Xamarin.Essentials.

    Fills WPR.Engine.Sensors.IAccelerometerProvider and nothing else. This is the shape a module is
    supposed to have: one seam, one technology, one project reference.

    Named for the library rather than the platform, per the module convention - a raw
    android.hardware.SensorManager implementation would be WPR.Input.AndroidSensorManager and would
    fill the same seam beside this one.

    net8.0-android only: Xamarin.Essentials is an Android binding. Spelled as a singular
    <TargetFramework> deliberately - Src/Directory.Build.targets only strips android legs from a
    plural <TargetFrameworks>, so the singular form is what keeps an android-only project intact on
    a machine without the workload, and WPR.Windows.slnf is the mechanism that keeps it out of a
    desktop build.

    Lived in WPR.Platform.Android/Input/ until 2026-09-02, and took the Xamarin.Essentials package
    reference with it when it left - the head was that package's only consumer in the repo.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <AssemblyName>WPR.Input.XamarinEssentials</AssemblyName>
    <RootNamespace>WPR.Input.XamarinEssentials</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)Engine\WPR.Engine.Sensors\WPR.Engine.Sensors.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.Essentials" Version="1.7.3" />
    <!--
      DO NOT REMOVE, and do not "fix" the conflict this prevents with
      XamarinGoogleGuavaListenableFutureOptOut / XamarinGoogleGuavaOptOut - see the long comment in
      WPR.Platform.Android.csproj: those opt-outs SIGSEGV the launcher a few seconds after start.

      Xamarin.Essentials 1.7.3 asks for the 2021-era AndroidX set, including
      Xamarin.Google.Guava.ListenableFuture 1.0.0.2. A module restores as its own graph, so when
      this left the head (2026-09-02) that old version stopped being unified with the head's, and
      the head ended up with BOTH: the 1.0.0.2 jar embedded in this project's build output, and the
      1.0.0.16 package NuGet resolves for the head (AndroidX.Core 1.12.0.2 pulls it). R8 then fails
      with "Type com.google.common.util.concurrent.ListenableFuture is defined multiple times".

      Pinning to the version the head already unifies to collapses that back to one copy. If the
      head's AndroidX versions ever move, this pin has to move with them - the symptom is a
      duplicate-class error at dex time, not a restore warning.
    -->
    <PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="1.0.0.16" />
  </ItemGroup>

</Project>
