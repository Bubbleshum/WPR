<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Diagnostics — logging/tracing foundation (Plans/ARCHITECTURE-MIGRATION.md,
    Stage 1). Dependency-free (no FNA, no WPR project references). Runtime and the
    layers above route diagnostics through IWprLog. Existing ad-hoc logging (e.g.
    the per-game wpr_game_debug.log) migrates onto this as consumers are touched in
    later stages — Stage 1 only stands the project up; it moves no existing code.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-android</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

</Project>
