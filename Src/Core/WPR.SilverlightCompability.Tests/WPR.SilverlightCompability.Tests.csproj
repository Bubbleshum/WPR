<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WPR.Framework.Silverlight\WPR.Framework.Silverlight.csproj" />
    <!-- PhoneApplicationFrame/Page/FrameView + gesture types moved here from SL. -->
    <!-- References the impl assembly directly (not the Microsoft.Phone forwarder shim) —
         the tests reach an internal (PhoneApplicationFrameView.ConvertBrush) exposed via
         WPR.Framework.Phone's InternalsVisibleTo, which a forwarder can't surface. -->
    <ProjectReference Include="..\WPR.Framework.Phone\WPR.Framework.Phone.csproj" />
  </ItemGroup>

</Project>
