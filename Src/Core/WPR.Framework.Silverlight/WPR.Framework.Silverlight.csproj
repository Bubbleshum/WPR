<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0;net8.0-windows10.0.17763.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaVersion>11.3.9</AvaloniaVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <!-- Absorbed from WPR.WindowsCompability when that project was dissolved (2026-08-30):
       Application, MessageBox, the Imaging bitmaps, IsolatedStorage, ProtectedData and the
       Path2/GC2/Type2/XElement2 redirect targets all live here now, under their original
       WPR.WindowsCompability namespace so the patcher's NewNamespace strings and every existing
       call site keep working. Three of them (Application, IsolatedStorageSettings2, XElement2)
       need WprHostEnvironment / Configuration, which is why this project — previously
       reference-free — now takes exactly one project reference. WPR.Common is foundational and
       references nothing back, so this stays one-way and cycle-free. -->
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Common\WPR.Common.csproj" />
    <!-- WPR.Engine.Content owns the path-resolution logic; the shims under System/IO and
         System/Xml are the thin call sites the patcher can name. The engine tier sits ABOVE the
         frameworks, and this project is what the reference points at rather than the other way
         round, so it stays cycle-free: WPR.Engine.Content references only WPR.Common. -->
    <ProjectReference Include="$(SolutionDir)\Engine\WPR.Engine.Content\WPR.Engine.Content.csproj" />
    <!-- For XnaBackend/IGraphicsBackend only, so BitmapSource.SetSource can decode an image with
         the codec the platform already ships (FNA3D's stb_image, reached through the RHI seam)
         instead of this project carrying a second one. The codec half of that seam is
         device-independent — ReadImageStream/FreeImage touch no GraphicsDevice.

         This is NOT a backend reference and does not re-open the leak the fitness test guards:
         WPR.Framework.Xna is a peer under Src/Core, and it references neither this project nor
         WPR.Framework.Phone, so the edge is one-way and cycle-free. It is also the right
         direction in practice — the games that reach WriteableBitmap through the patcher are XNA
         titles (Feed Me Oil loads its collision masks this way), so the XNA graphics backend is
         exactly what is registered when this runs. -->
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Xna\WPR.Framework.Xna.csproj" />
  </ItemGroup>

  <!--
    No Vortice / Direct3D references live here any more. Stage 5e (2026-08-29) moved the three
    D3D11 renderers into Src/Backends/WPR.Backend.Direct3D11 and left behind the
    ISurfaceRendererBackend seam + the SilverlightBackend registry, which the launcher fills in.
    The WPR_D3D11 define went with them — this project now compiles identically on all three TFMs.
    Re-adding a graphics package here would re-open the backend leak the fitness test guards.
  -->

</Project>
