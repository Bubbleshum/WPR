<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Runtime — application launch / lifecycle / host coordination
    (Plans/ARCHITECTURE-MIGRATION.md, Stage 2). Upper layer of the split from the old
    `WPR` core; depends on WPR.Loader (one-way). The XNA game-loop host (ApplicationLaunch)
    left this project in Stage 4; it now lives in WPR.Engine.GameLoop beside IGameHost
    (2026-09-20), and what remains here is the Silverlight boot (SilverlightAppHost) and the
    GameMaker launcher/achievement bridge. Types remain in `namespace WPR` so consumers
    compile unchanged.
  -->

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net10.0-windows10.0.17763.0;net10.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- GameMakerAchievementBridge compiles against DbContext/DbSet; make the package
         explicit rather than relying on transitive flow from GamerServices. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EFVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Loader\WPR.Loader.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Common\WPR.Common.csproj" />
    <!-- FNA + the XNA facades were removed here: the game-loop host (ApplicationLaunch)
         moved into WPR.Backend.FNA in Stage 4, so Runtime no longer binds any FNA/XNA-runtime
         type (verified: WPR.Runtime.dll's only XNA ref is GamerServices). This completes the
         Stage-4/5b intent of making Runtime FNA-free. -->
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Xna\WPR.Framework.Xna.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Phone\WPR.Framework.Phone.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Silverlight\WPR.Framework.Silverlight.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Devices.Sensors\WPR.Framework.Devices.Sensors.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Devices.Location\WPR.Framework.Devices.Location.csproj" />
  </ItemGroup>

</Project>
