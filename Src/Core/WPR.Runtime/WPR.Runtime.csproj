<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Runtime — application launch / lifecycle / host coordination
    (docs/ARCHITECTURE-MIGRATION.md, Stage 2). Upper layer of the split from the old
    `WPR` core; depends on WPR.Loader (one-way). Still references FNA + the XNA facades
    because the game-loop host (ApplicationLaunch.cs) drives them directly — that
    coupling is removed in Stage 5b when ApplicationLaunch moves behind IGameHost into
    WPR.Backend.FNA. Types remain in `namespace WPR` so consumers compile unchanged.
  -->

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0-windows10.0.17763.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <EFVersion Condition="'$(TargetFramework)' == 'net8.0-windows10.0.17763.0'">5.0.17</EFVersion>
    <EFVersion Condition="'$(TargetFramework)' != 'net8.0-windows10.0.17763.0'">6.0.8</EFVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">21.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- GameMakerAchievementBridge compiles against DbContext/DbSet; make the package
         explicit rather than relying on transitive flow from GamerServices. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EFVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Loader\WPR.Loader.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Common\WPR.Common.csproj" />
    <!-- FNA + the XNA facades were removed here: the game-loop host (ApplicationLaunch)
         moved into WPR.Backend.FNA in Stage 4, so Runtime no longer binds any FNA/XNA-runtime
         type (verified: WPR.Runtime.dll's only XNA ref is GamerServices). This completes the
         Stage-4/5b intent of making Runtime FNA-free. -->
    <ProjectReference Include="$(SolutionDir)\Core\Microsoft.Xna.Framework.GamerServices\Microsoft.Xna.Framework.GamerServices.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.XnaCompabilityPatch\WPR.XnaCompability.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Phone\WPR.Framework.Phone.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.WindowsCompability\WPR.WindowsCompability.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Devices.Sensors\WPR.Framework.Devices.Sensors.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Devices.Location\WPR.Framework.Devices.Location.csproj" />
  </ItemGroup>

</Project>
