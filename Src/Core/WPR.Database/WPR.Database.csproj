<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Database — the one home for WPR's persisted state: the EF Core schema, the shipped
    seed databases, and the first-run provisioning that puts them in place.

    Created 2026-08-30. Before this, database concerns were spread across three projects and
    the data was committed three times over:
      * applications.db schema lived in WPR.Loader (an install/IL-patch pipeline that had no
        business owning a catalogue schema);
      * achievements.db schema lived in WPR.Framework.Xna, i.e. inside the assembly patched
        games bind, dragging EF Core / Sqlite / SQLitePCLRaw in with it;
      * the seed data lived in Src/Database AND was committed a second time into the android
        head (1115 files) and a third time into the windows head (2 files), because both heads
        have MSBuild targets that copy it in and the copies got checked in.

    Namespaces are deliberately NOT changed by the move — the catalogue types stay in
    WPR.Models, exactly as WPR.Loader's own doc comment describes the Stage 2 split ("the split
    is by assembly, not namespace, so consumers compile unchanged"). ~30 consumer files across
    both heads therefore needed no code edit at all.

    Scope note: this project currently owns the applications.db half. The achievements half is
    a follow-up, because Achievement (the entity) is a GAME-FACING type — the patcher rescopes
    games' Microsoft.Xna.Framework.GamerServices.Achievement typerefs into WPR.Framework.Xna —
    so it cannot move here, while AchievementContext can. Splitting them naively would make
    WPR.Database -> WPR.Framework.Xna -> WPR.Database, a cycle. The fix is the IAchievementStore
    seam that already exists (unimplemented) in WPR.Abstractions; see ADR 1.4 / Stage 5e.
  -->

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0-windows10.0.17763.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">21.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EFVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EFVersion)" />
    <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q (High): SQLitePCLRaw <= 2.1.11 bundles a SQLite with a
         memory-corruption bug (fixed in SQLite 3.50.2). EF Core Sqlite pulls 2.0.4 transitively.
         Pinned above the affected range; the bundle lifts core / lib.e_sqlite3 / provider together.
         Kept here as well as in the other EF consumers so this project is safe standalone. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuration.DataPath — where the live .db files are opened from. -->
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Common\WPR.Common.csproj" />
    <!-- The XNA type system, for two things only: the Achievement entity (a game-facing type the
         patcher rescopes into WPR.Framework.Xna, so it cannot live here) and the
         WPR.Xna.Achievements.IAchievementStore seam this project implements.

         Direction matters: WPR.Database -> WPR.Framework.Xna and never the reverse. The framework
         consumes the seam through XnaBackend and knows nothing about EF, which is exactly what
         allowed its EF Core / Sqlite / SQLitePCLRaw references to be removed in Stage 5e. -->
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Xna\WPR.Framework.Xna.csproj" />
  </ItemGroup>

  <!--
    Data/ holds the seed content: the two pre-built .db files and the per-game achievement
    catalogues. It is data, not compiled content — the platform heads copy it into their own
    payload (windows: into $(OutputPath)\Database; android: as AndroidAsset). Excluded from
    compilation so the 1000+ json/png files never reach the compiler.
  -->
  <ItemGroup>
    <None Include="Data\**\*.*" />
    <Compile Remove="Data\**" />
    <EmbeddedResource Remove="Data\**" />
  </ItemGroup>

</Project>
