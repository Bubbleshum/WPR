<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Framework.Devices.Sensors — the WP7 sensors framework (Microsoft.Devices.Sensors.*).
    Organised in the WPR.Framework.* layer, but its OUTPUT ASSEMBLY keeps the game-facing identity
    <AssemblyName>Microsoft.Devices.Sensors</AssemblyName> so patched game IL binds the REAL
    implementation directly — no forwarder shim, no ApplicationPatcher change, no reinstall
    (see Plans/ARCHITECTURE-MIGRATION.md §3). Namespaces stay Microsoft.Devices.Sensors.*.

    De-FNA'd 2026-08-29 (Stage 5d). AccelerometerReading.Acceleration is a
    Microsoft.Xna.Framework.Vector3, which Stage 5a moved out of FNA into WPR.Framework.Xna — so
    this project references the owning assembly directly instead of reaching it transitively
    through FNA.Core. Nothing else here touches an FNA type, so the assembly is backend-clean
    and is no longer in the BackendIsolationTests baseline. Do not re-add an FNA edge.
  -->

  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0-windows10.0.17763.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <Nullable>enable</Nullable>
    <Version>8.0.0</Version>
    <AssemblyName>Microsoft.Devices.Sensors</AssemblyName>
    <RootNamespace>Microsoft.Devices.Sensors</RootNamespace>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ISensorProvider seam Accelerometer reads through. No platform package belongs here:
         the Xamarin.Essentials reference that used to sit in this group backed an
         #if __ANDROID__ branch inside Accelerometer.cs and was resolved for the desktop leg too,
         where nothing could use it. It moved to WPR.Platform.Android with the code (2026-08-30). -->
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Abstractions\WPR.Abstractions.csproj" />
    <ProjectReference Include="$(SolutionDir)\Core\WPR.Framework.Xna\WPR.Framework.Xna.csproj" />
  </ItemGroup>

</Project>
