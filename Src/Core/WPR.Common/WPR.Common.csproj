<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <TargetFrameworks>net8.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <!-- net8.0 is in this list even on Windows, for the same reason as
         WPR.Framework.Devices.Location: WPR.Framework.Silverlight multi-targets net8.0 (reached
         from the SL test project via WPR.Framework.Phone) and now references this project for
         WprHostEnvironment / Configuration, which the types absorbed from WPR.WindowsCompability
         need. Without a net8.0 leg here, Silverlight's net8.0 inner build fails with no compatible
         TFM. The non-Windows list above already builds net8.0, so the sources are known portable. -->
    <TargetFrameworks>net8.0;net8.0-windows10.0.17763.0;net8.0-android</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <!-- 21 (Android 5.0) matches the TargetPlatformVersion that the
         installed .NET 10 Android workload (android 36.1.43/10.0.100)
         assigns to a bare net8.0-android TFM. Setting it any higher
         triggers NETSDK1135 (SOSV > TPV). -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">21.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <!-- No Xamarin.Essentials. It was here until 2026-08-30 with no C# in this project using it,
         which put an Android sensor package in the dependency closure of nearly every assembly
         in the repo, desktop legs included. The one real consumer is
         WPR.Platform.Android/Input/AndroidSensorProvider. -->
  </ItemGroup>

  <!-- Default gamer-picture choices (the 9 stock WP7 avatars). Lives at the
       solution root in Src\GamerPictures\; embedded here so both the settings
       UI (thumbnail strip) and GamerServices (GamerProfile.GetGamerPicture)
       can read them by ID via WPR.Common.GamerPictureDefaults. LogicalName
       collapses to a flat WPR.Common.GamerPictures.<id>.png scheme. -->
  <ItemGroup>
    <EmbeddedResource Include="$(SolutionDir)\GamerPictures\*.png">
      <LogicalName>WPR.Common.GamerPictures.%(Filename).png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
