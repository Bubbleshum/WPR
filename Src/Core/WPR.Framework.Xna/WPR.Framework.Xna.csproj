<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPR.Framework.Xna — WPR-owned XNA type system (Stage 5a, docs/ARCHITECTURE-MIGRATION.md).

    First step of severing FNA. This assembly owns the pure, backend-independent XNA VALUE/MATH
    types (vendored from FNA's MIT source, now WPR-maintained): Vector2/3/4, Matrix, Quaternion,
    Color, Rectangle, Point, Plane, Ray, BoundingBox/Sphere/Frustum, Curve*, MathHelper, their
    System.ComponentModel Design converters, and IPackedVector (which Color implements).

    Types keep their real namespaces (Microsoft.Xna.Framework[.Design][.Graphics.PackedVector]).
    FNA.Core now REFERENCES this assembly for these types (its Vector2.cs etc. were removed), so
    FNA's runtime (GraphicsDevice, SpriteBatch, …) and games share ONE value-type identity — the
    prerequisite for reimplementing the runtime over WPR.Abstractions in 5b/5c.

    net8.0 (NOT multi-TFM) on purpose: FNA.Core is net8.0 and references this back, so this must be
    net8.0-compatible; the net8.0-windows/android facades + consumers still consume it fine.
    No FNA/native dependency → NOT a backend leak (absent from the fitness baseline).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>WPR.Framework.Xna</AssemblyName>
    <RootNamespace>Microsoft.Xna.Framework</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The relocated XNA graphics runtime (SpriteBatch/GraphicsDevice/Effect/PipelineCache/…)
         uses unsafe pointer code for vertex/state marshalling, as it did inside FNA. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- FNA's runtime (EffectParameter, SpriteBatch, …) uses internal helpers on the moved value
       types (Vector3/4.CheckForNaNs, MathHelper.MachineEpsilonFloat, etc.) that were same-assembly
       before this split. Grant FNA access so those stay internal rather than leaking to the public
       XNA surface. One-way: WPR.Framework.Xna never references FNA. -->
  <!-- The stock-effect + YUV shader blobs (used by SpriteBatch's static ctor via Resources.GetResource,
       and by the FNA VideoPlayer via IVT). Moved from FNA in 5c-1 with Resources.cs; the LogicalName MUST
       stay "Microsoft.Xna.Framework.Graphics.Effect.Resources.<name>.fxb" — that's what GetResource looks up. -->
  <ItemGroup>
    <EmbeddedResource Include="Graphics\Effect\StockEffects\FXB\AlphaTestEffect.fxb">
      <LogicalName>Microsoft.Xna.Framework.Graphics.Effect.Resources.AlphaTestEffect.fxb</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Graphics\Effect\StockEffects\FXB\BasicEffect.fxb">
      <LogicalName>Microsoft.Xna.Framework.Graphics.Effect.Resources.BasicEffect.fxb</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Graphics\Effect\StockEffects\FXB\DualTextureEffect.fxb">
      <LogicalName>Microsoft.Xna.Framework.Graphics.Effect.Resources.DualTextureEffect.fxb</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Graphics\Effect\StockEffects\FXB\EnvironmentMapEffect.fxb">
      <LogicalName>Microsoft.Xna.Framework.Graphics.Effect.Resources.EnvironmentMapEffect.fxb</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Graphics\Effect\StockEffects\FXB\SkinnedEffect.fxb">
      <LogicalName>Microsoft.Xna.Framework.Graphics.Effect.Resources.SkinnedEffect.fxb</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Graphics\Effect\StockEffects\FXB\SpriteEffect.fxb">
      <LogicalName>Microsoft.Xna.Framework.Graphics.Effect.Resources.SpriteEffect.fxb</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Graphics\Effect\YUVToRGBA\YUVToRGBAEffect.fxb">
      <LogicalName>Microsoft.Xna.Framework.Graphics.Effect.Resources.YUVToRGBAEffect.fxb</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FNA" />
    <!-- 5c-4: the FNA backend implements framework-internal contracts (it constructs Microphone,
         and its XACT file reader shares the moved MonoGame.Utilities.FileHelpers path helpers).
         Visibility only — WPR.Framework.Xna still references nothing. -->
    <InternalsVisibleTo Include="WPR.Backend.FNA" />
  </ItemGroup>

</Project>
