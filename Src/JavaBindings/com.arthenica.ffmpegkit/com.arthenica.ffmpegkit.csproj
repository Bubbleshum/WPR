<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <!--
      Was `net8.0` until 2026-08-31, which silently made this a no-op project:
      LibraryProjectZip and class-parse only run on an android TFM, so the build
      produced a 4 KB assembly containing no types. Nothing in the repo could
      call FFmpegKit because there was no FFmpegKit to call — which is why
      AudioCompabilityConverter ended up on desktop-only FFMpegCore for "all
      platforms" and WP7 .wma soundtracks were left untranscoded on Android.
      Modelled on Org.Libsdl.App, the one binding project here that was correct.
    -->
    <TargetFramework>net8.0-android</TargetFramework>
    <!-- 21.0 matches Org.Libsdl.App; higher trips NETSDK1135. -->
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <AndroidClassParser>class-parse</AndroidClassParser>
    <AndroidCodegenTarget>XAJavaInterop1</AndroidCodegenTarget>
  </PropertyGroup>
  <ItemGroup>
    <LibraryProjectZip Include="Jar\com.arthenica.ffmpegkit.aar" />
  </ItemGroup>
  <ItemGroup>
    <TransformFile Include="Transforms\Metadata.xml" />
    <TransformFile Include="Transforms\EnumFields.xml" />
    <TransformFile Include="Transforms\EnumMethods.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\com.arthenica.smartexception.java\com.arthenica.smartexception.java.csproj" />
    <ProjectReference Include="..\com.arthenica.smartexception\com.arthenica.smartexception.csproj" />
  </ItemGroup>
</Project>
