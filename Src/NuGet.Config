<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      AvaloniaUI's internal "avalonia-all@Local" Azure DevOps feed. Every Avalonia
      package this repo references is a public release version on nuget.org, so the
      feed is not needed to restore - and because <clear /> above makes this list
      exhaustive, an unreachable or auth-gated source here fails restore outright
      (NU1301) for anyone cloning. Re-enable only when pinning an Avalonia nightly.

    <add key="avalonia-all@Local" value="https://pkgs.dev.azure.com/AvaloniaUI/AvaloniaUI/_packaging/avalonia-all%40Local/nuget/v3/index.json" protocolVersion="3" />
    -->
  </packageSources>
</configuration>
