<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Loads installed WP8 native titles headless (no window, no GPU) and runs their entry points for a
    bounded instruction budget, reporting what the module loader did: which package DLLs were mapped,
    where, how many relocations, each DllMain's result, and imports left to the host stubs.

      Wp8ModuleProbe [<budget in millions>] [<product id or install folder>...]

    Not part of WPR.sln; built against the engine project, like Wp8ContractTests. Reads the
    installed packages only; anything the guest writes goes to a temp sandbox.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Src\Engine\WPR.Engine.Wp8Native\WPR.Engine.Wp8Native.csproj" />
  </ItemGroup>

</Project>
